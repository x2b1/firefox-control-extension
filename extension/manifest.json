{
  "manifest_version": 2,
  "name": "Pentest Bridge",
  "version": "1.0.0",
  "description": "Local agent bridge for authorized security testing. Talks only to 127.0.0.1:9104 and is inert on domains you have not explicitly enabled.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pentest-bridge@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "cookies",
    "storage"
  ],
  "background": {
    "scripts": ["lib/util.js", "lib/policy.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/policy.js", "bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    "hook.js"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pentest Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
